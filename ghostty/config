# ===== Ghostty (managed by dotfiles) =====
theme = TokyoNight Night
font-family = JetBrainsMono Nerd Font
font-size = 13

window-padding-x = 8
window-padding-y = 8
cursor-style = block
mouse-hide-while-typing = true
copy-on-select = clipboard
confirm-close-surface = false

# 시작 시 전체화면 + F11로 토글
fullscreen = true
keybind = f11=toggle_fullscreen
